ANNECY_SIG_BASE_URL=https://portailsig.annecy.fr/server/rest/services
DEFAULT_RESULT_LIMIT=100
MAX_RESULT_LIMIT=1000
DEFAULT_MODE=public

# Rayon max (m) pour search_nearby — défaut 5000 si absent
# MAX_SEARCH_RADIUS_METERS=5000

# Optionnel : classement open data de la couche Travaux (internal) — orange (défaut) ou red
# OPEN_DATA_TRAVAUX_TIER=orange

# ----------------------------------------------------------------------------
# Politique des contrats (Zod) sur les rapports — strict en CI/dev, warn en prod
# ----------------------------------------------------------------------------
# CONTRACT_POLICY=warn

# ----------------------------------------------------------------------------
# Performance ArcGIS (timeouts, cache GET en mémoire)
# ----------------------------------------------------------------------------
# ARCGIS_TIMEOUT_MS=10000
# ARCGIS_CACHE_TTL_MS=300000

# ----------------------------------------------------------------------------
# Transport HTTP distant (Vercel) — n'a aucun effet sur le bootstrap stdio local
# ----------------------------------------------------------------------------
# Force `mode = "public"` côté serveur HTTP (refus explicite de mode=internal).
# Fortement recommandé pour un déploiement public (Cursor / Copilot remote).
REMOTE_PUBLIC_ONLY=true

# Autorise l'enregistrement des outils internal-only (travaux, dashboard)
# sur le transport HTTP. À NE PAS activer sans passerelle restricted DSI.
REMOTE_ALLOW_INTERNAL_TOOLS=false

# Token Bearer optionnel exigé sur /api/mcp.
# - Vide / absent en local : auth désactivée (utile pour smoke / dev).
# - Défini en production Vercel : Authorization: Bearer <token> requis.
# - Aucun token n'est journalisé ni renvoyé au client.
# MCP_PUBLIC_READ_TOKEN=

# Sel cryptographique utilisé pour générer `id_public` (vue travaux public-light)
# via SHA-256. À DÉFINIR EN PRODUCTION VERCEL avec une valeur aléatoire :
#   openssl rand -hex 32
# - Vide / absent en local : fallback non sensible (warning stderr).
# - Défini en production : empêche toute corrélation entre id_public et l'OBJECTID interne.
PUBLIC_WORK_ID_SALT=change-me-in-production

# Répertoire d'export des rapports (writeOutput=true). Sur Vercel : laisser vide
# ou pointer vers /tmp (filesystem éphémère).
# REPORT_OUTPUT_DIR=outputs
