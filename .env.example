ANNECY_SIG_BASE_URL=https://portailsig.annecy.fr/server/rest/services
DEFAULT_RESULT_LIMIT=100
MAX_RESULT_LIMIT=1000
DEFAULT_MODE=public

# Rayon max (m) pour search_nearby — défaut 5000 si absent
# MAX_SEARCH_RADIUS_METERS=5000

# Optionnel : classement open data de la couche Travaux (internal) — orange (défaut) ou red
# OPEN_DATA_TRAVAUX_TIER=orange

# ----------------------------------------------------------------------------
# Politique des contrats (Zod) sur les rapports — strict en CI/dev, warn en prod
# ----------------------------------------------------------------------------
# CONTRACT_POLICY=warn

# ----------------------------------------------------------------------------
# Performance ArcGIS (timeouts, cache GET en mémoire)
# ----------------------------------------------------------------------------
# ARCGIS_TIMEOUT_MS=10000
# ARCGIS_CACHE_TTL_MS=300000

# ----------------------------------------------------------------------------
# Transport HTTP distant (Vercel) — n'a aucun effet sur le bootstrap stdio local
# ----------------------------------------------------------------------------
# Force `mode = "public"` côté serveur HTTP (refus explicite de mode=internal).
# Fortement recommandé pour un déploiement public (Cursor / Copilot remote).
REMOTE_PUBLIC_ONLY=true

# Autorise l'enregistrement des outils internal-only (travaux, dashboard)
# sur le transport HTTP. À NE PAS activer sans passerelle restricted DSI.
REMOTE_ALLOW_INTERNAL_TOOLS=false

# Token Bearer optionnel exigé sur /api/mcp (système MONO-TOKEN — pas de
# multi-token, pas de tokenId, pas de révocation par token ; rotation
# centralisée côté Vercel — voir SECURITY.md).
# - Vide / absent en local : auth désactivée (utile pour smoke / dev).
# - Défini en production Vercel : Authorization: Bearer <token> requis.
# - Aucun token n'est journalisé ni renvoyé au client.
# MCP_PUBLIC_READ_TOKEN=

# Token admin facultatif protégeant /api/health/internal.
# Si absent, fallback sur MCP_PUBLIC_READ_TOKEN (compromis « simple par défaut »).
# Recommandé en prod : valeur dédiée, distincte du token public.
# MCP_ADMIN_TOKEN=

# ----------------------------------------------------------------------------
# Rate limiting (V1.2)
# ----------------------------------------------------------------------------
# Active/désactive le rate limiting côté /api/mcp.
MCP_RATE_LIMIT_ENABLED=true
# Limite par IP cliente (par minute).
MCP_RATE_LIMIT_IP_PER_MINUTE=60
# Limite globale /api/mcp (par minute, toutes IPs confondues).
MCP_RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Limite par IP sur les outils lourds (par heure).
MCP_RATE_LIMIT_HEAVY_TOOL_PER_HOUR=30

# Backend Redis Upstash optionnel (REST) — si défini, remplace le store
# mémoire qui ne survit pas aux invocations Vercel multi-instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# Timeouts MCP HTTP (V1.2)
# ----------------------------------------------------------------------------
# Timeout global d'une requête /api/mcp (ms). Réponse JSON-RPC -32030 si dépassé.
MCP_REQUEST_TIMEOUT_MS=25000
# Timeout dédié aux outils lourds (inventory_*, generate_*, recommend_open_data).
MCP_HEAVY_TOOL_TIMEOUT_MS=20000

# ----------------------------------------------------------------------------
# CORS (V1.2)
# ----------------------------------------------------------------------------
# Liste d'origines autorisées (CSV). Défaut : "*" (comportement historique).
# Exemple restreint :
#   MCP_CORS_ALLOWED_ORIGINS=https://copilot.microsoft.com,https://chat.openai.com
MCP_CORS_ALLOWED_ORIGINS=*

# ----------------------------------------------------------------------------
# Sel cryptographique pour `id_public` (vue travaux public-light)
# ----------------------------------------------------------------------------
# À DÉFINIR EN PRODUCTION VERCEL avec une valeur aléatoire :
#   openssl rand -hex 32
# - Vide / absent en local : fallback non sensible (warning stderr).
# - Défini en production : empêche toute corrélation entre id_public et l'OBJECTID interne.
PUBLIC_WORK_ID_SALT=change-me-in-production

# Répertoire d'export des rapports (writeOutput=true). Sur Vercel : laisser vide
# ou pointer vers /tmp (filesystem éphémère).
# REPORT_OUTPUT_DIR=outputs

# ----------------------------------------------------------------------------
# Smoke prod (npm run smoke:prod)
# ----------------------------------------------------------------------------
# Variables consommées uniquement par scripts/smoke-prod.ts (jamais loggées en clair).
# MCP_REMOTE_URL=https://mcp.leadalpes.fr/api/mcp
# MCP_REMOTE_HEALTH_URL=https://mcp.leadalpes.fr/api/health
