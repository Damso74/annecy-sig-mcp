{
  "$ref": "#/definitions/InventoryLayerRow",
  "definitions": {
    "ServiceKey": {
      "type": "string",
      "minLength": 1,
      "description": "Clé d’un service du registre (ex. `equipements`, `mobilite`, `travaux`)."
    },
    "LayerId": {
      "type": "integer",
      "minimum": 0,
      "description": "Identifiant numérique d’une couche ArcGIS (entier ≥ 0)."
    },
    "ServerVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Version applicative du serveur MCP — issue de package.json (`SERVER_VERSION`)."
    },
    "RuntimeMs": {
      "type": "number",
      "minimum": 0,
      "description": "Durée totale du traitement côté serveur, exprimée en millisecondes."
    },
    "ReportFormat": {
      "type": "string",
      "enum": [
        "json",
        "markdown"
      ],
      "description": "Format de sortie d’un rapport (JSON structuré ou Markdown)."
    },
    "VisibilityMode": {
      "type": "string",
      "enum": [
        "public",
        "internal"
      ],
      "description": "Mode de visibilité : `public` filtre les couches internal, `internal` les inclut."
    },
    "SampleStatus": {
      "type": "string",
      "enum": [
        "ok",
        "empty",
        "failed"
      ],
      "description": "Statut de l’échantillon ArcGIS récupéré (succès non vide / vide / échec)."
    },
    "GeometryStatus": {
      "type": "string",
      "enum": [
        "present",
        "missing",
        "unknown"
      ],
      "description": "Présence de la géométrie sur l’échantillon ArcGIS."
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "green",
        "orange",
        "red"
      ],
      "description": "Niveau de risque métier/juridique déclaré dans le registre."
    },
    "UsageStatus": {
      "type": "string",
      "enum": [
        "ready",
        "usable_now",
        "usable_with_caution",
        "needs_field_mapping",
        "needs_data_cleaning",
        "to_investigate_technically",
        "internal_only",
        "not_usable"
      ],
      "description": "Statut métier d’usage agrégé sur la couche (V0.5+)."
    },
    "SamplingMode": {
      "type": "string",
      "enum": [
        "fast",
        "standard"
      ],
      "description": "Mode d’échantillonnage utilisé pour la passe d’inventaire."
    },
    "SampleFallbackUsed": {
      "type": "string",
      "enum": [
        "registry_valid",
        "star",
        "objectid_only",
        "none"
      ],
      "description": "Stratégie de fallback utilisée pour récupérer l’échantillon."
    },
    "InventoryTarget": {
      "type": "object",
      "properties": {
        "serviceKey": {
          "$ref": "#/definitions/ServiceKey"
        },
        "layerId": {
          "$ref": "#/definitions/LayerId",
          "description": "Identifiant numérique d’une couche ArcGIS (entier ≥ 0)."
        }
      },
      "required": [
        "serviceKey"
      ],
      "additionalProperties": false,
      "description": "Cible d’inventaire — sans `layerId`, toutes les couches visibles du service dans le mode courant."
    },
    "InventoryDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Code court du diagnostic (ex. SAMPLE_FAILED, GEOMETRY_MISSING)."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "description": "Sévérité du diagnostic."
        },
        "message": {
          "type": "string",
          "description": "Message lisible (sanitisé en amont)."
        },
        "details": {
          "type": "object",
          "additionalProperties": {},
          "description": "Détails additionnels (libre)."
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "additionalProperties": false,
      "description": "Diagnostic structuré rattaché à une couche d’inventaire."
    },
    "InventoryDiagnosticsCounts": {
      "type": "object",
      "properties": {
        "failedSamples": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de couches en échec d’échantillon."
        },
        "emptySamples": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de couches à échantillon vide."
        },
        "geometryUnknownLayers": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de couches dont la géométrie n’a pas pu être évaluée."
        }
      },
      "required": [
        "failedSamples",
        "emptySamples",
        "geometryUnknownLayers"
      ],
      "additionalProperties": false,
      "description": "Agrégats compacts des diagnostics, exposés dans `source.diagnostics`."
    },
    "InventoryExecutionMeta": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Niveau de parallélisme effectif."
        },
        "fast": {
          "type": "boolean",
          "description": "Indique si le mode rapide a été utilisé (sample = 1)."
        },
        "requestedSampleLimit": {
          "type": "integer",
          "minimum": 0,
          "description": "Limite d’échantillon demandée."
        },
        "effectiveSampleLimit": {
          "type": "integer",
          "minimum": 0,
          "description": "Limite d’échantillon réellement transmise à ArcGIS."
        },
        "serviceKeysFilter": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ServiceKey"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Liste des `serviceKeys` filtrants, ou null si non utilisé."
        },
        "targetsFilter": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/InventoryTarget"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Liste des cibles `targets` filtrantes, ou null si non utilisé."
        }
      },
      "required": [
        "concurrency",
        "fast",
        "requestedSampleLimit",
        "effectiveSampleLimit",
        "serviceKeysFilter",
        "targetsFilter"
      ],
      "additionalProperties": false,
      "description": "Métadonnées d’exécution de la passe d’inventaire (concurrency, fast, filtres)."
    },
    "InventorySourceV1": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "annecy_sig_mcp_inventory"
        },
        "schemaVersion": {
          "type": "string",
          "const": "inventory.v1",
          "description": "Version stable du schéma `inventory.v1`."
        },
        "serverVersion": {
          "$ref": "#/definitions/ServerVersion"
        },
        "runtimeMs": {
          "$ref": "#/definitions/RuntimeMs"
        },
        "layersScanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de couches effectivement parcourues."
        },
        "diagnostics": {
          "$ref": "#/definitions/InventoryDiagnosticsCounts"
        },
        "execution": {
          "$ref": "#/definitions/InventoryExecutionMeta"
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "serverVersion",
        "runtimeMs",
        "layersScanned",
        "diagnostics",
        "execution"
      ],
      "additionalProperties": false,
      "description": "Bloc `source` d’un résultat d’inventaire (contrat `inventory.v1`)."
    },
    "InventoryLayerRow": {
      "type": "object",
      "properties": {
        "serviceKey": {
          "$ref": "#/definitions/ServiceKey"
        },
        "layerId": {
          "$ref": "#/definitions/LayerId"
        },
        "layerName": {
          "type": "string"
        },
        "visibility": {
          "$ref": "#/definitions/VisibilityMode"
        },
        "riskLevel": {
          "$ref": "#/definitions/RiskLevel"
        },
        "geometryType": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "fields": {
          "type": "object",
          "properties": {
            "publicFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "internalFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "publicFields"
          ],
          "additionalProperties": false
        },
        "sampleReturned": {
          "type": "integer",
          "minimum": 0
        },
        "hasGeometryInSample": {
          "type": "boolean"
        },
        "geometryStatus": {
          "$ref": "#/definitions/GeometryStatus"
        },
        "sampleStatus": {
          "$ref": "#/definitions/SampleStatus"
        },
        "sampleError": {
          "type": "string"
        },
        "sampleFallbackUsed": {
          "$ref": "#/definitions/SampleFallbackUsed"
        },
        "fieldValidation": {
          "type": "object",
          "properties": {
            "validFields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Noms canoniques tels qu’exposés par ArcGIS (utilisables dans `outFields`)."
            },
            "missingFields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Champs demandés par le registre mais absents de la couche."
            },
            "ignoredFields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Champs présents côté ArcGIS mais non demandés (liste plafonnée)."
            },
            "objectIdField": {
              "type": [
                "string",
                "null"
              ]
            },
            "geometryType": {
              "type": [
                "string",
                "null"
              ]
            },
            "supportsQuery": {
              "type": "boolean"
            }
          },
          "required": [
            "validFields",
            "missingFields",
            "ignoredFields",
            "objectIdField",
            "geometryType",
            "supportsQuery"
          ],
          "additionalProperties": false,
          "description": "Confrontation des champs registre avec les métadonnées ArcGIS de la couche."
        },
        "nullRateSummary": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InventoryDiagnostic"
          }
        },
        "suggestedUseCases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preliminaryQualityScore": {
          "type": "number"
        },
        "scoreBreakdown": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "semanticMappings": {
          "type": "object",
          "additionalProperties": {}
        },
        "semanticValidation": {
          "type": "object",
          "properties": {
            "validMappings": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Clé sémantique → nom canonique du champ ArcGIS."
            },
            "invalidMappings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "field",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "missingEssentialMappings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Clés sémantiques essentielles absentes ou invalides."
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "validMappings",
            "invalidMappings",
            "missingEssentialMappings",
            "warnings"
          ],
          "additionalProperties": false,
          "description": "Résultat de la validation des `semanticMappings` registre vs ArcGIS."
        },
        "semanticCoverage": {
          "type": "object",
          "properties": {
            "totalFeatures": {
              "type": "integer",
              "minimum": 0,
              "description": "Nombre d’entités effectivement échantillonnées."
            },
            "coverageByMapping": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Nom du champ ArcGIS effectivement utilisé pour ce mapping."
                  },
                  "nonNullCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "nullCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "coverageRatio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Ratio non-null / total (3 décimales)."
                  }
                },
                "required": [
                  "field",
                  "nonNullCount",
                  "nullCount",
                  "coverageRatio"
                ],
                "additionalProperties": false
              },
              "description": "Couverture par clé sémantique (`labelField`, `addressField`, …)."
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "totalFeatures",
            "coverageByMapping",
            "warnings"
          ],
          "additionalProperties": false,
          "description": "Couverture sémantique calculée sur l’échantillon (V0.5+)."
        },
        "usageStatus": {
          "$ref": "#/definitions/UsageStatus"
        },
        "usageWarnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technicalScore": {
          "type": "number"
        },
        "dataQualityScore": {
          "type": "number"
        },
        "samplingMode": {
          "$ref": "#/definitions/SamplingMode"
        }
      },
      "required": [
        "serviceKey",
        "layerId",
        "layerName",
        "visibility",
        "riskLevel",
        "geometryType",
        "count",
        "fields",
        "sampleReturned",
        "hasGeometryInSample",
        "geometryStatus",
        "sampleStatus",
        "sampleFallbackUsed",
        "fieldValidation",
        "nullRateSummary",
        "warnings",
        "diagnostics",
        "suggestedUseCases",
        "preliminaryQualityScore",
        "scoreBreakdown",
        "semanticValidation",
        "semanticCoverage",
        "usageStatus",
        "usageWarnings",
        "technicalScore",
        "dataQualityScore",
        "samplingMode"
      ],
      "additionalProperties": true,
      "description": "Ligne d’inventaire pour une couche (V0.5/V0.6/V0.7)."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
