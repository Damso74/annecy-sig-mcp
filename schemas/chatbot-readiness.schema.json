{
  "$ref": "#/definitions/ChatbotReadinessReport",
  "definitions": {
    "ServiceKey": {
      "type": "string",
      "minLength": 1,
      "description": "Clé d’un service du registre (ex. `equipements`, `mobilite`, `travaux`)."
    },
    "LayerId": {
      "type": "integer",
      "minimum": 0,
      "description": "Identifiant numérique d’une couche ArcGIS (entier ≥ 0)."
    },
    "ServerVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Version applicative du serveur MCP — issue de package.json (`SERVER_VERSION`)."
    },
    "RuntimeMs": {
      "type": "number",
      "minimum": 0,
      "description": "Durée totale du traitement côté serveur, exprimée en millisecondes."
    },
    "ReportFormat": {
      "type": "string",
      "enum": [
        "json",
        "markdown"
      ],
      "description": "Format de sortie d’un rapport (JSON structuré ou Markdown)."
    },
    "VisibilityMode": {
      "type": "string",
      "enum": [
        "public",
        "internal"
      ],
      "description": "Mode de visibilité : `public` filtre les couches internal, `internal` les inclut."
    },
    "SampleStatus": {
      "type": "string",
      "enum": [
        "ok",
        "empty",
        "failed"
      ],
      "description": "Statut de l’échantillon ArcGIS récupéré (succès non vide / vide / échec)."
    },
    "GeometryStatus": {
      "type": "string",
      "enum": [
        "present",
        "missing",
        "unknown"
      ],
      "description": "Présence de la géométrie sur l’échantillon ArcGIS."
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "green",
        "orange",
        "red"
      ],
      "description": "Niveau de risque métier/juridique déclaré dans le registre."
    },
    "UsageStatus": {
      "type": "string",
      "enum": [
        "ready",
        "usable_now",
        "usable_with_caution",
        "needs_field_mapping",
        "needs_data_cleaning",
        "to_investigate_technically",
        "internal_only",
        "not_usable"
      ],
      "description": "Statut métier d’usage agrégé sur la couche (V0.5+)."
    },
    "SamplingMode": {
      "type": "string",
      "enum": [
        "fast",
        "standard"
      ],
      "description": "Mode d’échantillonnage utilisé pour la passe d’inventaire."
    },
    "SampleFallbackUsed": {
      "type": "string",
      "enum": [
        "registry_valid",
        "star",
        "objectid_only",
        "none"
      ],
      "description": "Stratégie de fallback utilisée pour récupérer l’échantillon."
    },
    "InventoryTarget": {
      "type": "object",
      "properties": {
        "serviceKey": {
          "$ref": "#/definitions/ServiceKey"
        },
        "layerId": {
          "$ref": "#/definitions/LayerId",
          "description": "Identifiant numérique d’une couche ArcGIS (entier ≥ 0)."
        }
      },
      "required": [
        "serviceKey"
      ],
      "additionalProperties": false,
      "description": "Cible d’inventaire — sans `layerId`, toutes les couches visibles du service dans le mode courant."
    },
    "InventoryDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Code court du diagnostic (ex. SAMPLE_FAILED, GEOMETRY_MISSING)."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "description": "Sévérité du diagnostic."
        },
        "message": {
          "type": "string",
          "description": "Message lisible (sanitisé en amont)."
        },
        "details": {
          "type": "object",
          "additionalProperties": {},
          "description": "Détails additionnels (libre)."
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "additionalProperties": false,
      "description": "Diagnostic structuré rattaché à une couche d’inventaire."
    },
    "InventoryDiagnosticsCounts": {
      "type": "object",
      "properties": {
        "failedSamples": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de couches en échec d’échantillon."
        },
        "emptySamples": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de couches à échantillon vide."
        },
        "geometryUnknownLayers": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de couches dont la géométrie n’a pas pu être évaluée."
        }
      },
      "required": [
        "failedSamples",
        "emptySamples",
        "geometryUnknownLayers"
      ],
      "additionalProperties": false,
      "description": "Agrégats compacts des diagnostics, exposés dans `source.diagnostics`."
    },
    "InventoryExecutionMeta": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Niveau de parallélisme effectif."
        },
        "fast": {
          "type": "boolean",
          "description": "Indique si le mode rapide a été utilisé (sample = 1)."
        },
        "requestedSampleLimit": {
          "type": "integer",
          "minimum": 0,
          "description": "Limite d’échantillon demandée."
        },
        "effectiveSampleLimit": {
          "type": "integer",
          "minimum": 0,
          "description": "Limite d’échantillon réellement transmise à ArcGIS."
        },
        "serviceKeysFilter": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ServiceKey"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Liste des `serviceKeys` filtrants, ou null si non utilisé."
        },
        "targetsFilter": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/InventoryTarget"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Liste des cibles `targets` filtrantes, ou null si non utilisé."
        }
      },
      "required": [
        "concurrency",
        "fast",
        "requestedSampleLimit",
        "effectiveSampleLimit",
        "serviceKeysFilter",
        "targetsFilter"
      ],
      "additionalProperties": false,
      "description": "Métadonnées d’exécution de la passe d’inventaire (concurrency, fast, filtres)."
    },
    "InventorySourceV1": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "annecy_sig_mcp_inventory"
        },
        "schemaVersion": {
          "type": "string",
          "const": "inventory.v1",
          "description": "Version stable du schéma `inventory.v1`."
        },
        "serverVersion": {
          "$ref": "#/definitions/ServerVersion"
        },
        "runtimeMs": {
          "$ref": "#/definitions/RuntimeMs"
        },
        "layersScanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de couches effectivement parcourues."
        },
        "diagnostics": {
          "$ref": "#/definitions/InventoryDiagnosticsCounts"
        },
        "execution": {
          "$ref": "#/definitions/InventoryExecutionMeta"
        }
      },
      "required": [
        "type",
        "schemaVersion",
        "serverVersion",
        "runtimeMs",
        "layersScanned",
        "diagnostics",
        "execution"
      ],
      "additionalProperties": false,
      "description": "Bloc `source` d’un résultat d’inventaire (contrat `inventory.v1`)."
    },
    "ChatbotReadinessReport": {
      "type": "object",
      "properties": {
        "executiveSummary": {
          "type": "string"
        },
        "ready": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "serviceKey": {
                "$ref": "#/definitions/ServiceKey"
              },
              "layerId": {
                "$ref": "#/definitions/LayerId"
              },
              "layerName": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "serviceKey",
              "layerId",
              "layerName",
              "label"
            ],
            "additionalProperties": false,
            "description": "Référence compacte d’une couche (identifiant + label utilisateur)."
          }
        },
        "usableNow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "serviceKey": {
                "$ref": "#/definitions/ServiceKey"
              },
              "layerId": {
                "$ref": "#/definitions/LayerId"
              },
              "layerName": {
                "$ref": "#/definitions/ChatbotReadinessReport/properties/ready/items/properties/layerName"
              },
              "label": {
                "$ref": "#/definitions/ChatbotReadinessReport/properties/ready/items/properties/label"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "serviceKey",
              "layerId",
              "layerName",
              "label",
              "reasons"
            ],
            "additionalProperties": false,
            "description": "Référence d’une couche enrichie de motifs lisibles."
          }
        },
        "usableWithCaution": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChatbotReadinessReport/properties/usableNow/items"
          }
        },
        "notReady": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChatbotReadinessReport/properties/usableNow/items"
          }
        },
        "unknownRequiresCheck": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChatbotReadinessReport/properties/usableNow/items"
          }
        },
        "perLayer": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "serviceKey": {
                "$ref": "#/definitions/ServiceKey"
              },
              "layerId": {
                "$ref": "#/definitions/LayerId"
              },
              "layerName": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "ready",
                  "usable_now",
                  "usable_with_caution",
                  "not_ready",
                  "unknown_requires_check"
                ]
              },
              "missingForGoodCitizenAnswer": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "safeAnswerRules": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mustQualifyAnswer": {
                "type": "boolean"
              },
              "hallucinationRisks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "serviceKey",
              "layerId",
              "layerName",
              "label",
              "tier",
              "missingForGoodCitizenAnswer",
              "safeAnswerRules",
              "mustQualifyAnswer",
              "hallucinationRisks",
              "reasons"
            ],
            "additionalProperties": false,
            "description": "Détail couche pour le rapport de maturité chatbot citoyen."
          }
        },
        "typicalQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hallucinationRisks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "annecy_sig_mcp_chatbot_readiness"
            },
            "schemaVersion": {
              "type": "string",
              "const": "chatbot_readiness.v1"
            },
            "serverVersion": {
              "$ref": "#/definitions/ServerVersion"
            },
            "inventory": {
              "$ref": "#/definitions/InventorySourceV1"
            },
            "runtimeMs": {
              "$ref": "#/definitions/RuntimeMs",
              "description": "Durée totale du traitement côté serveur, exprimée en millisecondes."
            }
          },
          "required": [
            "type",
            "schemaVersion",
            "serverVersion",
            "inventory"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "executiveSummary",
        "ready",
        "usableNow",
        "usableWithCaution",
        "notReady",
        "unknownRequiresCheck",
        "perLayer",
        "typicalQuestions",
        "hallucinationRisks",
        "source"
      ],
      "additionalProperties": true,
      "description": "Rapport de maturité chatbot citoyen — contrat `chatbot_readiness.v1`."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
